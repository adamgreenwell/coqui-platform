APP_NAME="Coqui SEO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=coqui_platform
DB_USERNAME=coqui
DB_PASSWORD=coqui_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=coqui_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=coqui-seo
REVERB_APP_KEY=coqui-reverb-key
REVERB_APP_SECRET=coqui-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# DataForSEO (default to sandbox in non-production; scheduled spend disabled by default)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_API_BASE_URL=https://sandbox.dataforseo.com
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_SCHEDULED_SPEND=false
DATAFORSEO_LOAD_ASYNC_AI_OVERVIEW=true
DATAFORSEO_DAILY_CAP_USD=5.00
DATAFORSEO_MONTHLY_CAP_USD=100.00
DATAFORSEO_TASK_MAX_AGE_HOURS=12
DATAFORSEO_SPEND_LOCK_WAIT_SECONDS=10
DATAFORSEO_ARCHIVE_RESPONSES=true
DATAFORSEO_ARCHIVE_RETENTION_DAYS=30
DATAFORSEO_DRIFT_ALERT_USD=1.00
DATAFORSEO_LOW_BALANCE_ALERT_USD=10.00
DATAFORSEO_CAP_ALERT_RATIO=0.8
DATAFORSEO_WEBHOOK_SECRET=

# SERPHouse rank-tracking fallback (re-checks failed or stalled rank tasks)
SERPHOUSE_API_KEY=
SERPHOUSE_FALLBACK_ENABLED=false
SERPHOUSE_DAILY_CAP_USD=2.00
SERPHOUSE_MONTHLY_CAP_USD=25.00

# SE Ranking Data API (standalone API credits; keyword & domain endpoints)
SERANKING_API_KEY=
SERANKING_API_BASE_URL=https://api.seranking.com
SERANKING_SOURCE=us
SERANKING_SCHEDULED_SPEND=false
SERANKING_DAILY_CREDIT_CAP=5000
SERANKING_MONTHLY_CREDIT_CAP=100000

# Public MCP Surface (auth defaults to on everywhere except APP_ENV=local;
# API tokens need the mcp:use ability)
# COQUI_MCP_REQUIRE_AUTH=true
# COQUI_MCP_RATE_LIMIT=60

# Coqui Cloud Worker (headless Rust coqui-core engine)
COQUI_WORKER_URL=http://coqui-worker:8085
COQUI_WORKER_TOKEN=

# Stripe billing (webhooks are rejected outside APP_ENV=local until STRIPE_WEBHOOK_SECRET is set)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (price_...). Without STRIPE_SECRET, billing is simulated in local/testing and refused elsewhere.
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_RUNNR_ADDON=

# First-party Integrations & Runnr Hosting Platform
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; register this single URI in Google Cloud Console. Defaults to ${APP_URL}/integrations/google/callback
GOOGLE_REDIRECT_URI=
BING_WEBMASTER_API_KEY=
RUNNR_WEBHOOK_SECRET=
RUNNR_WEBHOOK_TOLERANCE_SECONDS=300
RUNNR_TELEMETRY_TOKEN=

# Local demo data (`php artisan db:seed`; refuses to run when APP_ENV=production)
DEMO_USER_EMAIL=demo@coqui.test
DEMO_USER_PASSWORD=password
